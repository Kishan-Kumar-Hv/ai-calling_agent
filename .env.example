# --- Twilio (telephony) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# --- Deepgram (Voice Agent API: listen + speak) ---
DEEPGRAM_API_KEY=

# --- Google AI Studio (Agent "think" provider: Gemini) ---
GOOGLE_API_KEY=

# --- HubSpot (CRM) ---
HUBSPOT_ACCESS_TOKEN=

# --- Service ports ---
API_GATEWAY_PORT=3000
VOICE_PIPELINE_PORT=8080
CALL_ORCHESTRATOR_PORT=4000
CRM_SYNC_PORT=8081

# --- Public URLs (set these to your ngrok tunnels when running locally) ---
API_GATEWAY_PUBLIC_URL=https://your-api-gateway.ngrok.io
VOICE_PIPELINE_WS_URL=wss://your-voice-pipeline.ngrok.io/media-stream
CRM_SYNC_URL=http://localhost:8081

# --- Production Extensions ---
TWILIO_TEAM_TRANSFER_NUMBER=
WHATSAPP_SENDER_NUMBER=
PORTFOLIO_URL=
